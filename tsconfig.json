// The /espresso_sync page's React sources (espresso_sync/www/espresso_sync/src). App-owned:
// declared in pyproject.toml's [[tool.frappe-nix.typescript.spa]]. Frappe's esbuild reads
// "jsx" from here too. The managed projects are in tsconfig.solution.json.
{
	"extends": "frappe-types/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		// Browser code: none of node_modules/@types (Node's timers, say) unless imported.
		"types": [],
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		// @carbon/react's declarations import prop-types and aren't written for these strict
		// flags; the app's own code is still checked with them.
		"skipLibCheck": true
	},
	"include": ["espresso_sync/www/espresso_sync/src/**/*.ts", "espresso_sync/www/espresso_sync/src/**/*.tsx"],
	"exclude": ["node_modules", "espresso_sync/public/dist"]
}
