{
	"name": "espresso-sync",
	"version": "16.0.0",
	"private": true,
	"description": "Two-way REST API sync: JSONata transforms checked against OpenAPI and DocTypes",
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:css": "stylelint \"espresso_sync/public/**/*.scss\"",
		"typecheck": "tsc --build tsconfig.solution.json && tsc -p tsconfig.json",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-include='espresso_sync/public/js/**' --test-coverage-lines=50 'test/unit/**/*.test.ts'",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"ci:lint": "oxlint -c oxlint.react.json espresso_sync/www/espresso_sync/src",
		"check": "yarn -s format:check && yarn -s lint && yarn -s lint:css && yarn -s typecheck && yarn -s test:unit"
	},
	"dependencies": {
		"@carbon/react": "^1.120.0",
		"@scalar/json-magic": "^0.18.0",
		"@scalar/openapi-parser": "^0.29.20",
		"ajv": "^8.20.0",
		"frappe-react-sdk": "^1.17.1",
		"jsonata": "^2.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"frappe-types": "^16.6.0",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.87.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
