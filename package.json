{
	"name": "espresso-sync",
	"version": "0.0.1",
	"private": true,
	"description": "Two-way sync between Frappe documents and external REST APIs",
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --build tsconfig.solution.json && tsc -p tsconfig.json",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-include='espresso_sync/public/js/**' --test-coverage-lines=50 'test/unit/**/*.test.ts'",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck && yarn -s test:unit",
		"build": "vite build && node scripts/vite-register.mjs",
		"build:bundle": "vite build",
		"ci:lint": "oxlint -c oxlint.react.json espresso_sync/www/espresso_sync/src",
		"ci:typecheck": "yarn -s build:bundle"
	},
	"dependencies": {
		"@carbon/react": "^1.120.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"frappe-react-sdk": "^1.17.1",
		"jsonata": "^2.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"ajv": "^8.20.0",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.87.0",
		"sass": "^1.108.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.6"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
