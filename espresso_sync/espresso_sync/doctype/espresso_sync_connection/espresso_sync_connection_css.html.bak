/* Reset previous styles */
.form-grid .grid-heading-row .data-row .col:not(.row-check):not(.row-index) {
    display: flex;
}

/* Set the columns width */
.form-grid .grid-body .rows .grid-row .data-row .col.grid-static-col {
    flex-basis: 25%;
}

/* Display the Object Map on a new full-width row */
.form-grid .grid-body .rows .grid-row .data-row .col[data-fieldname="object_map"] {
    flex-basis: 100%;
    grid-column-start: 2;
    grid-row-start: 2;
}

/* Adjust the height for the Object Map field */
.form-grid .grid-body .rows .grid-row .data-row .col[data-fieldname="object_map"] .static-area {
    min-height: 19rem;
}

/* Move the btn-open-row button to the right side */
.form-grid .grid-body .rows .grid-row .data-row .col:last-of-type {
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: flex-end;
}
